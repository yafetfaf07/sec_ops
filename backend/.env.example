# Copy to .env for local development. Never commit .env.
# On Cloud Run, set these with --set-env-vars / --set-secrets instead.

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# Neon / Supabase free-tier Postgres (use the pooled connection string).
DATABASE_URL=postgres://user:password@host:5432/secops?sslmode=require
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m

# Comma-separated exact origins. Defaults to localhost:5173,3000 outside production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Required (>= 32 chars) in production. Left empty in development generates
# an ephemeral per-process secret (sessions won't survive a restart).
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# The refresh cookie. In production both must effectively be true/None
# because the frontend and API are on different origins; config.go enforces
# COOKIE_SECURE=true in production. Leave COOKIE_SECURE unset locally over
# http:// (it defaults to false outside production).
COOKIE_SECURE=false

SHUTDOWN_TIMEOUT=8s
SCAN_TIMEOUT=14m

# First admin account, created once at startup if no active admin exists yet.
# Both or neither; password must be 12-72 characters.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now-12+chars
BOOTSTRAP_ADMIN_NAME=Administrator

# Optional: lets an automated log shipper call POST /logs/ingest with the
# X-Ingest-Key header instead of an admin JWT. >= 32 chars when set.
INGEST_API_KEY=

# Gemini (FR-SEC-002 AI analysis, FR-SEC-011 NL query). Leave GEMINI_API_KEY
# empty to run everything else without AI analysis (scans defer every batch).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_RPM=8
GEMINI_DAILY_BUDGET=200
GEMINI_MAX_BATCHES_PER_SCAN=3
GEMINI_MAX_LOGS_PER_BATCH=500

# AbuseIPDB (FR-SEC-004 threat intel enrichment). Leave empty to skip
# enrichment entirely (incidents still get created, just never escalated).
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com
ABUSEIPDB_DAILY_BUDGET=900
ABUSE_ESCALATE_THRESHOLD=50

# Alert webhooks (FR-SEC-005). Leave both empty to only record
# ALERT_SUPPRESSED in the audit log instead of actually notifying anyone.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# Shown in alert messages as a link back to the incident; usually the
# frontend's public URL.
DASHBOARD_URL=http://localhost:5173

# Cloud Scheduler OIDC auth for POST /scan/daily. Both or neither; when
# unset, /scan/daily only accepts an admin JWT (fine for local dev/demo).
SCHEDULER_AUDIENCE=
SCHEDULER_SA_EMAIL=
# projects/P/locations/L/jobs/J — lets admins pause/resume/reschedule the
# job from Settings. Optional even when the two above are set.
SCHEDULER_JOB_NAME=

# Optional: enables database integration tests (`go test ./...`).
# Point at a disposable database; tests create and drop a schema.
# TEST_DATABASE_URL=
